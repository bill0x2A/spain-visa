{
  "name": "spanish-visa-todo",
  "version": "1.0.0",
  "description": "TODO app for tracking Spanish Digital Nomad Visa application process",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "postinstall": "cd client && npm install && npm run build && cd ../server && npm install && npx prisma generate"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "spain",
    "digital nomad",
    "visa",
    "todo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
